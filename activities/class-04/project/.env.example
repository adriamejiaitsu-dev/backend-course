# Class 04 — local configuration. Copy this file to .env and fill it in:
#   cp .env.example .env
#
# DATABASE_URL: copy it from the Supabase Connect dialog — never type it by hand.
# On IPv4-only networks use the Session pooler string from the same dialog (port 5432).
# NEVER commit, paste or share the real value: .env is ignored by git.
DATABASE_URL=

# Port for the local HTTP server.
PORT=3000
